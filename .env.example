# Copy this file to .env and fill in your own keys. Never commit .env.
# Only fill in the provider(s) you use.

# Gemini (src/collect.py --provider gemini). Key from aistudio.google.com
GEMINI_API_KEY=

# Groq (src/collect.py --provider groq). Key from console.groq.com
GROQ_API_KEY=

# Ollama (src/collect.py --provider ollama, e.g. llama3.1:8b on the lab GPU).
# Local or lab GPU: keep http://localhost:11434 and leave the key empty (free, no key).
# Ollama Cloud: https://ollama.com plus a key (paid per token).
OLLAMA_URL=http://localhost:11434
OLLAMA_API_KEY=

# Judge (used only by src/judge.py). JUDGE_PROVIDER is groq, gemini or ollama (ollama uses OLLAMA_URL above).
# The judge model must not be one of the models being tested, or from the same family.
JUDGE_PROVIDER=ollama
JUDGE_MODEL=gpt-oss:20b
