# Copy this file to .env and fill in your own keys. Never commit .env.
GEMINI_API_KEY=
GROQ_API_KEY=
# Judge (used only by src/judge.py). JUDGE_PROVIDER is groq or gemini.
# The judge model must not be one of the models being tested, or from the same family.
JUDGE_PROVIDER=groq
JUDGE_MODEL=
# Ollama (src/collect.py --provider ollama). Local default: http://localhost:11434. Ollama Cloud: https://ollama.com plus a key.
OLLAMA_URL=
OLLAMA_API_KEY=
